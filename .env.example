# ============================================================
# Noor Ethnic Wear — saari env variables ka template
# Asli keys yahan NAHI daalte. Production me hosting dashboard se set karein.
# Rule: phone / WhatsApp / UPI / announcement **code me hardcoded nahi** —
#       sab Google Sheet → Settings tab se aata hai (site 3 second me padh leti hai).
# ============================================================

# ---- Storefront (apps/web) ----
# apna domain (deploy ke baad) — WhatsApp/invoice/canonical links isi se bante hain.
# Abhi domain nahi hai to deployed URL daal dijiye (jaise https://noor-ethnic-wear.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# apne hosts (comma se alag) — traffic tracking / canonical ke liye. Optional.
NEXT_PUBLIC_SITE_HOSTS=
# emergency override — normal case me khaali chhodiye, Sheet hi source hai
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP=
# payment yahan aata hai. Asli source Google Sheet (Settings → upi_id) hai.
# Ye sirf emergency fallback — khaali chhodna hi behtar hai.
STORE_UPI_ID=
STORE_UPI_NAME=Noor Ethnic Wear
ADMIN_API_TOKEN=change-me-in-production

# ---- Database (Supabase Postgres) ----
# Serverless par DATABASE_URL dena ZAROORI hai. Na do to data /tmp me jaayega
# (deploy ke baad gayab). Supabase pooler ka transaction-mode URL best hai.
DATABASE_URL=
DATABASE_URL_POOLED=
DB_POOL_MAX=

# ---- Google Sheets (owner ka control panel, DB ke upar) ----
# scripts/google-apps-script/noor-sheets.gs deploy karke jo /exec URL milta hai.
# Setup: docs/09-devops/google-sheets.md
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_TOKEN=
# Sheet ka id (safety check — galat sheet pakadne par site warning deti hai)
SHEET_EXPECTED_ID=
# Sheet → site real-time tuning. Defaults kaafi hain; badalna ho tabhi bharein.
SHEET_READ_TIMEOUT_MS=4000
SHEET_SETTINGS_TTL_MS=10000
SHEET_SETTINGS_STALE_MS=600000
# Fallback: Settings tab ka "Publish to web" CSV (Apps Script na ho to). Google ise
# ~5 minute cache karta hai — real-time chahiye to upar wala /exec URL hi use karein.
GOOGLE_SHEETS_SETTINGS_CSV_URL=
# Selftest endpoint (key-gated) — `/api/sheet-selftest?key=...`
SHEET_SELFTEST_KEY=
# UPI return callback ka secret (order auto-confirm token). Na do to ADMIN_API_TOKEN use hota hai.
UPI_RETURN_SECRET=
# Admin panel ka public link (sheet ke Settings → admin_url me bhi daal sakte hain)
ADMIN_PANEL_URL=
NEXT_PUBLIC_ADMIN_URL=
# Static preview build ke liye (GitHub Pages) — set ho to checkout/payment API par jaata hai
NEXT_PUBLIC_API_BASE_URL=
CORS_ALLOWED_ORIGINS=

# ---- Contact form ("Send us a message") ----
# Message pehle DB me save hota hai, phir Google Sheet (Messages tab) me jaata hai.
CONTACT_EMAIL=
CONTACT_FORM_ENDPOINT=
RESEND_API_KEY=
EMAIL_FROM=Noor Ethnic Wear <onboarding@resend.dev>

# ---- Phone OTP (Firebase) — optional ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
REQUIRE_PHONE_OTP=0
OTP_TOKEN_SECRET=
OTP_DEV_MODE=on

# ---- GST invoice ----
SELLER_NAME=Noor Ethnic Wear
SELLER_GSTIN=
SELLER_EMAIL=
SELLER_PHONE=
SELLER_ADDRESS=
SELLER_STATE=
GST_HSN=6204

# ---- Payments ----
# Koi third-party gateway nahi — sirf UPI (Sheet → upi_id).

# ---- Admin (apps/admin) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me-before-go-live
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# ---- API (apps/api) ----
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# ---- Notifications (optional) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
