# Netlify site #2 — admin panel (apps/admin) ke env variables
# ---------------------------------------------------------------
# Netlify → (admin site) → Project configuration → Environment variables →
# "Import from a .env file" me ye poori file paste karein.
#
# ⚠️ ADMIN_API_TOKEN site #1 (storefront) ke ADMIN_API_TOKEN se BILKUL same hona
#    chahiye — warna admin panel 401 dega.
# ⚠️ STORE_API_URL / NEXT_PUBLIC_* me site #1 ka URL daalna hai (admin khud API
#    chalata hai, pages site #1 se aate hain).

# 1) Login
ADMIN_EMAIL=admin@noorethnicwear.in
ADMIN_PASSWORD=<VERCEL SE COPY>
ADMIN_SESSION_SECRET=<VERCEL SE COPY — openssl rand -hex 32>

# 2) Storefront API (site #1 ka URL)
STORE_API_URL=https://noor-clothing.netlify.app
NEXT_PUBLIC_STORE_URL=https://noor-clothing.netlify.app
NEXT_PUBLIC_STOREFRONT_URL=https://noor-clothing.netlify.app

# 3) Must match site #1
ADMIN_API_TOKEN=<VERCEL SE COPY — storefront ke ADMIN_API_TOKEN se same>

# 4) Optional — admin ka apna link (sheet Settings → admin_url me bhi daalein)
ADMIN_PANEL_URL=https://noor-admin.netlify.app

# 5) Optional — sheet page par "configured" status dikhane ke liye
# GOOGLE_SHEETS_WEBAPP_URL=<VERCEL SE COPY>
