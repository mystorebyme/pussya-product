# Netlify site #1 — storefront (apps/web) ke env variables
# ---------------------------------------------------------------
# Netlify → Project configuration → Environment variables → "Import from a .env file"
# me ye poori file paste karein, phir <...> wali values bhar dein.
#
# ⚠️ <VERCEL SE COPY> ka matlab: Vercel → noor-web project → Settings →
#    Environment variables → usi key ka value copy karke yahan paste karein.
# ⚠️ Site par support email kahin nahi dikhni chahiye — CONTACT_EMAIL/SELLER_EMAIL
#    ki zarurat nahi hai.

# 1) Site ka apna URL (domain aane par badal dein)
NEXT_PUBLIC_SITE_URL=https://noor-clothing.netlify.app

# 2) UPI (customer isi par pay karta hai)
STORE_UPI_ID=
STORE_UPI_NAME=Noor Ethnic Wear

# 3) Admin panel ka token — admin site ke ADMIN_API_TOKEN se SAME hona chahiye
ADMIN_API_TOKEN=<VERCEL SE COPY>

# 4) Google Sheet (owner ka control panel)
GOOGLE_SHEETS_WEBAPP_URL=<VERCEL SE COPY — script.google.com/macros/s/.../exec>
GOOGLE_SHEETS_TOKEN=<VERCEL SE COPY>

# 5) Database (Supabase Postgres — transaction pooler URL, port 6543)
DATABASE_URL=<SUPABASE → Settings → Database → Connection pooling ka URI>

# 6) Sheet selftest endpoint ki key (optional, testing ke liye)
SHEET_SELFTEST_KEY=<VERCEL SE COPY>

# 7) Payment return / OTP tokens
UPI_RETURN_SECRET=<VERCEL SE COPY>
OTP_TOKEN_SECRET=<VERCEL SE COPY>
OTP_DEV_MODE=on

# 8) Extra CORS origins (GitHub Pages preview already default me allowed hai)
CORS_ALLOWED_ORIGINS=https://mystorebyme.github.io

# 9) Optional — GST invoice par chhapta hai
# SELLER_GSTIN=
# GST_HSN=6204
# SELLER_NAME=Noor Ethnic Wear
# SELLER_STATE=Rajasthan

# 10) Optional — Google Analytics 4
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
