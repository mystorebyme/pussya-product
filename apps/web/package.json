{
  "name": "@noor/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node ../../scripts/build-policies.mjs && node ../../scripts/build-invoice-logo.mjs && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "node ../../scripts/build-policies.mjs && node ../../scripts/build-invoice-logo.mjs && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@noor/api-client": "*",
    "@noor/types": "*",
    "@noor/validation": "*",
    "@vinext/cloudflare": "^1.2.1",
    "firebase": "^13.1.0",
    "next": "16.2.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "^0.0.1",
    "vinext": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.5",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.23",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  },
  "type": "module"
}
