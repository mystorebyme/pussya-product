{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@noor/types": ["../../packages/types/index.ts"],
      "@noor/validation": ["../../packages/validation/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
